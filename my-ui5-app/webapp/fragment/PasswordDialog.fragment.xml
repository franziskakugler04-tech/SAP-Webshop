<core:FragmentDefinition
    xmlns:core="sap.ui.core"
    xmlns:form="sap.ui.layout.form"
    xmlns="sap.m">

    <!-- Das Passwort wird nicht in der Zeile geändert, sondern hier: es braucht drei
         Felder - das bisherige zur Bestätigung und das neue zweimal -->
    <Dialog
        id="profilePasswordDialog"
        title="{i18n>profilePasswordDialogTitle}"
        contentWidth="30rem"
        stretch="{device>/system/phone}"
        afterClose="onPasswordDialogClose">
        <content>
            <form:SimpleForm
                layout="ResponsiveGridLayout"
                editable="true"
                labelSpanXL="12"
                labelSpanL="12"
                labelSpanM="12"
                labelSpanS="12"
                adjustLabelSpan="false">
                <form:content>
                    <Label text="{i18n>profilePasswordCurrentLabel}" required="true" labelFor="profilePasswordCurrentInput"/>
                    <Input
                        id="profilePasswordCurrentInput"
                        type="Password"
                        value="{profile>/Password/Current}"
                        liveChange="onInputLiveChange"/>

                    <Label text="{i18n>profilePasswordNewLabel}" required="true" labelFor="profilePasswordNewInput"/>
                    <Input
                        id="profilePasswordNewInput"
                        type="Password"
                        value="{profile>/Password/New}"
                        placeholder="{i18n>registerPasswordPlaceholder}"
                        liveChange="onInputLiveChange"/>

                    <Label text="{i18n>profilePasswordRepeatLabel}" required="true" labelFor="profilePasswordRepeatInput"/>
                    <Input
                        id="profilePasswordRepeatInput"
                        type="Password"
                        value="{profile>/Password/Repeat}"
                        liveChange="onInputLiveChange"/>
                </form:content>
            </form:SimpleForm>
        </content>

        <!-- beginButton und endButton bilden die Fiori-Reihenfolge ab:
             die abschließende Aktion links, Abbrechen rechts -->
        <beginButton>
            <Button
                text="{i18n>profilePasswordDialogSaveBtn}"
                type="Emphasized"
                press="onSavePassword"/>
        </beginButton>
        <endButton>
            <Button
                text="{i18n>profilePasswordDialogCancelBtn}"
                type="Transparent"
                press="onCancelPassword"/>
        </endButton>
    </Dialog>

</core:FragmentDefinition>
