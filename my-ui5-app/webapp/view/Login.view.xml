<mvc:View
    controllerName="my.ui5.app.controller.Login"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns:form="sap.ui.layout.form"
    xmlns="sap.m">
    <Page title="{i18n>loginTitle}" showNavButton="true" navButtonPress="onNavBack">
        <content>

            <!-- Mittig stehende Karte; die Breite kommt aus style.css und ist in
                 rem angegeben, damit die Seite auf dem Phone mitwächst -->
            <VBox class="authCard">
                <Text text="{i18n>loginIntro}"/>

                <!-- Hinweis auf den Demo-Zugang, damit die Anmeldung in der
                     Vorführung ohne vorherige Registrierung gezeigt werden kann -->
                <MessageStrip
                    text="{i18n>loginDemoHint}"
                    type="Information"
                    showIcon="true"/>

                <!-- Sammelmeldung statt Feldmarkierung: Ob E-Mail oder Passwort
                     falsch war, soll die Seite bewusst nicht verraten -->
                <MessageStrip
                    id="loginErrorStrip"
                    text="{i18n>loginFailed}"
                    type="Error"
                    showIcon="true"
                    visible="false"/>

                <!-- labelSpan auf 12 stellt die Beschriftung über das Feld -
                     auf schmalen Bildschirmen bleibt so alles lesbar -->
                <form:SimpleForm
                    layout="ResponsiveGridLayout"
                    editable="true"
                    labelSpanXL="12"
                    labelSpanL="12"
                    labelSpanM="12"
                    labelSpanS="12"
                    adjustLabelSpan="false">
                    <form:content>
                        <Label text="{i18n>loginEmailLabel}" required="true" labelFor="loginEmailInput"/>
                        <Input
                            id="loginEmailInput"
                            type="Email"
                            placeholder="{i18n>loginEmailPlaceholder}"
                            liveChange="onInputLiveChange"
                            submit="onLogin"/>

                        <Label text="{i18n>loginPasswordLabel}" required="true" labelFor="loginPasswordInput"/>
                        <Input
                            id="loginPasswordInput"
                            type="Password"
                            placeholder="{i18n>loginPasswordPlaceholder}"
                            liveChange="onInputLiveChange"
                            submit="onLogin"/>
                    </form:content>
                </form:SimpleForm>

                <Button
                    text="{i18n>loginSubmitBtn}"
                    type="Emphasized"
                    press="onLogin"/>

                <!-- Wer noch kein Konto hat, kommt von hier zur Registrierung -->
                <Button
                    text="{i18n>loginRegisterLink}"
                    type="Transparent"
                    press="onNavToRegister"/>
            </VBox>

            <!-- Fußzeile als letztes Element im Seiteninhalt, damit sie mit
                 dem Inhalt scrollt statt ihn zu überdecken -->
            <core:Fragment fragmentName="my.ui5.app.fragment.GlobalFooter" type="XML"/>
        </content>
    </Page>
</mvc:View>
